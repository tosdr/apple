    "about_organization_desc2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ToS;DR ist eine gemeinnützige Organisation, und alle unsere Teammitglieder und Mitwirkenden arbeiten ehrenamtlich, eine Bezahlung erfolgt selten. Wir sind auf Spenden angewiesen, um unsere Infrastruktur und den Betrieb aufrechtzuerhalten, und unsere Finanzen sind über unsere Website und kollektive Websites einsehbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ToS;DR is a non-profit organization, and all of our team members and contributors do their work as volunteers, with payment being rare. We rely on donations to keep our infrastructure and operations up, and our finances are laid out through our website and collective websites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ToS;DR is a non-profit organization, and all of our team members and contributors do their work as volunteers, with payment being rare. We rely on donations to keep our infrastructure and operations up, and our finances are laid out through our website and collective websites."
          }
        },
        "fr" : {
