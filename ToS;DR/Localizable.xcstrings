    "service_review_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ToS;DR klassisch als 'Umfassend Bewertet' bezeichnet, was bedeutet, dass dieser Dienst ausreichend kuratierte Punkte hat, um für eine Alltagsbewertung als genau genug angesehen zu werden."
