    "donate_personal_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ToS;DR-Teammitglieder und Mitwirkende werden in der Regel nicht für ihre Arbeit bezahlt. Wir möchten dennoch gerne Pizza und Kaffee für die harte Arbeit, die wir investieren, um unsere Ziele zu erreichen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ToS;DR Team Members and contributers do not get paid for their work generally. We still like to get Pizza and Coffee for our hard work we put in to achieve our goals!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
