    "about_organization_desc1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Terms of Service; Didn't Read\" (kurz: ToS;DR) ist ein junges Projekt, das im Juni 2012 gestartet wurde, um die \"größte Lüge im Internet\" zu bekämpfen: fast niemand liest wirklich die Nutzungsbedingungen, denen wir ständig zustimmen. Wir streben an, die Nutzungsbedingungen und Datenschutzrichtlinien beliebter Webdienste zu bewerten, indem wir sie in \"praktische\" Noten von A bis E mit sogenannten \"Punkten\" zusammenfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Terms of Service; Didn't Read\" (short: ToS;DR) is a young project started in June 2012 to help fix the \"biggest lie on the web\": almost no one really reads the terms of service we agree to all the time. We aim at rating popular web services Terms of Service and Privacy Policies by summarizing them in \"convenient\" grades from A to E with so called \"Points\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"Terms of Service; Didn't Read\" (short: ToS;DR) is a young project started in June 2012 to help fix the \"biggest lie on the web\": almost no one really reads the terms of service we agree to all the time. We aim at rating popular web services Terms of Service and Privacy Policies by summarizing them in \"convenient\" grades from A to E with so called \"Points\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"Terms of Service; Didn't Read\" (short: ToS;DR) is a young project started in June 2012 to help fix the \"biggest lie on the web\": almost no one really reads the terms of service we agree to all the time. We aim at rating popular web services Terms of Service and Privacy Policies by summarizing them in \"convenient\" grades from A to E with so called \"Points\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"Terms of Service; Didn't Read\" (short: ToS;DR) is a young project started in June 2012 to help fix the \"biggest lie on the web\": almost no one really reads the terms of service we agree to all the time. We aim at rating popular web services Terms of Service and Privacy Policies by summarizing them in \"convenient\" grades from A to E with so called \"Points\"."
          }
        },
